<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Edge-to-edge Compose app; the theme only supplies the pre-Compose window and splash. -->
    <style name="Theme.Issuegram" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
